rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'dassomnath2025@gmail.com' ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email.lower() == 'dassomnath2025@gmail.com')
      );
    }

    // Validation Functions
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'handle', 'avatar']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.handle is string && data.handle.size() <= 80 &&
        data.avatar is string && data.avatar.size() <= 500000;
    }

    function isValidPin(data) {
      return data.keys().hasAll(['id', 'title', 'imageUrl', 'authorId', 'authorName', 'category']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 800000 &&
        data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
        (!isSignedIn() || data.authorId == request.auth.uid || isAdmin() || data.authorId.matches('^pin-.*|guest_.*|anonymous_.*')) &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.category is string && data.category.size() <= 80;
    }

    function isValidBoard(data) {
      return data.keys().hasAll(['id', 'userId', 'name']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        (!isSignedIn() || data.userId == request.auth.uid || isAdmin()) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'pinId', 'authorId', 'authorName', 'text']) &&
        data.id is string && data.id.size() <= 128 &&
        data.pinId is string && data.pinId.size() <= 128 &&
        data.authorId is string && data.authorId.size() <= 128 &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 1500;
    }

    // Collections
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isValidId(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin() || !isSignedIn()) && isValidUser(incoming());
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /pins/{pinId} {
      allow get, list: if true;
      allow create: if isValidId(pinId) && isValidPin(incoming());
      allow update: if isValidId(pinId) && (
        (isSignedIn() && existing().authorId == request.auth.uid && isValidPin(incoming())) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'savesCount', 'comments', 'savedInBoardId']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if isValidId(commentId) && isValidComment(incoming());
        allow update: if (isSignedIn() && existing().authorId == request.auth.uid) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
        allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());
      }
    }

    match /boards/{boardId} {
      allow get: if resource.data.isPrivate != true || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if true;
      allow create: if isValidId(boardId) && isValidBoard(incoming());
      allow update: if isValidId(boardId) && (!isSignedIn() || resource.data.userId == request.auth.uid || isAdmin()) && isValidBoard(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /configs/{configId} {
      allow get, list: if true;
      allow create: if isAdmin() || !exists(/databases/$(database)/documents/configs/donation);
      allow update, delete: if isAdmin();
    }
  }
}
